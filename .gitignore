# рода: в git едут только роды проекта, личные остаются на диске
houses/*
!houses/Gleann_Uruisg_tree.ged
!houses/Winterhope_tree.ged
!houses/O_Dubhain_tree.ged
!houses/Monadh_Croibhe_tree.ged

# рабочие и служебные папки
.work/
.superpowers/
.impeccable/
.claude/settings.local.json

# собранная витрина: пересобирается командой npm run build:pages
docs/витрина/
web/public/core.zip
