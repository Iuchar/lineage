# зависимости и сборки
server/.venv/
web/node_modules/
web/dist/
__pycache__/
*.pyc
.pytest_cache/

# данные приложения: база и портреты живут вне git
data/*
!data/.gitkeep

# рода: в git едут только роды проекта, личные остаются на диске
houses/*
!houses/Ashford_tree.ged
!houses/Hartley_tree.ged
!houses/Pryce_tree.ged
!houses/Drake_tree.ged
!houses/Macintosh_tree.ged
!houses/Wakefield_tree.ged
!houses/Davis_tree.ged

# рабочие и служебные папки
.work/
.superpowers/
.impeccable/
.claude/settings.local.json

# собранная витрина: пересобирается командой npm run build:pages
docs/витрина/
web/public/core.zip
